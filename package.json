{
  "name": "spansk-ungdomsskole",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/styles/tailwind.css -o ./dist/tailwind.css --minify",
    "check:tailwind": "node scripts/check-tailwind-adoption.mjs",
    "check:content": "node scripts/check-content-quality.mjs",
    "test:backup-privacy": "playwright test tests/backup-privacy.spec.js --browser chromium",
    "test:import-export": "playwright test tests/import-export-compat.spec.js --browser chromium",
    "test:storage-recovery": "playwright test tests/storage-recovery.spec.js --browser chromium",
    "test:chapter-focus": "playwright test tests/chapter-focus.spec.js --browser chromium",
    "test:completion-header": "playwright test tests/completion-header.spec.js --browser chromium",
    "test:teacher-import": "playwright test tests/teacher-glossary-import.spec.js --browser chromium",
    "test:vocab-mechanics": "playwright test tests/vocab-learning-mechanics.spec.js --browser chromium",
    "test:grammar-explanations": "playwright test tests/grammar-explanations.spec.js --browser chromium",
    "test:pwa-ui": "playwright test tests/pwa-and-ui-smoke.spec.js --browser chromium",
    "test:chapter-text-import": "playwright test tests/chapter-text-import.spec.js --browser chromium",
    "test:verb-focus": "playwright test tests/verb-focus.spec.js --browser chromium",
    "test:all": "npm run check:content && npm run check:tailwind && npm run test:backup-privacy && npm run test:import-export && npm run test:storage-recovery && npm run test:chapter-focus && npm run test:completion-header && npm run test:teacher-import && npm run test:vocab-mechanics && npm run test:grammar-explanations && npm run test:pwa-ui && npm run test:chapter-text-import && npm run test:verb-focus"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.1.17",
    "tailwindcss": "^4.1.17"
  }
}
