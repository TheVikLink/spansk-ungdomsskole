# Kopier til .env via npm run setup:school-demo for kun lokal syntetisk OIDC.
# Ingen verdier her er hemmeligheter eller gyldige produksjonsinnstillinger.
NODE_ENV=
LOCAL_OIDC_TEST_ENABLED=
HOST=
PORT=
PUBLIC_ORIGIN=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=
# Recommended Feide MFA ACR for school administrators. Production must set this.
FEIDE_ADMIN_REQUIRED_ACR=urn:mace:feide.no:auth:level:fad08:3
# Optional policy: require this exact Feide ACR for teacher access to pupil data.
FEIDE_TEACHER_REQUIRED_ACR=
MIGRATOR_PASSWORD=
RUNTIME_PASSWORD=
SCHOOL_OWNER_PROVISIONER_PASSWORD=
JOURNAL_MIGRATOR_PASSWORD=
JOURNAL_RUNTIME_PASSWORD=
MIGRATION_DATABASE_URL=
DATABASE_URL=
SCHOOL_OWNER_PROVISIONING_DATABASE_URL=
JOURNAL_MIGRATION_DATABASE_URL=
SECURITY_JOURNAL_DATABASE_URL=
# Skole-runtime: TLS i Feide/produksjon. CA-feltene er valgfrie offentlige PEM-sertifikater.
# I Vercel legges hele PEM-teksten inn som Config; aldri slå av sertifikatkontrollen.
DATABASE_SSL=
DATABASE_SSL_CA=
SECURITY_JOURNAL_DATABASE_SSL_CA=

# Første skoleadministrator krever et separat, godkjent produksjonsvindu.
SCHOOL_ADMIN_BOOTSTRAP_ENABLED=
SCHOOL_PROVISIONING_DATABASE_SSL=
SCHOOL_PROVISIONING_DATABASE_URL=

# Eierregistrering/sperring krever eget privilegert DB-vindu; sperring bruker sikkerhetsjournal.
SCHOOL_OWNER_BOOTSTRAP_ENABLED=
SCHOOL_OWNER_PROVISIONING_DATABASE_SSL=
SECURITY_JOURNAL_DATABASE_SSL=

# Undervisningspakken (tilstandsløs skolelisens for 46 timer)
# Egen hemmelighet (minst 16 tegn) som signerer og verifiserer SP123-skolekoder.
# Faller tilbake til SESSION_SECRET hvis tom, men bør settes separat i produksjon
# slik at rotering av SESSION_SECRET ikke gjør aktive skolekoder ugyldige.
LICENSE_SIGNING_SECRET=
# Valgfri overstyring (aktiv som standard på Vercel; sett til true for lokal test av betalingsmur).
UNDERVISNING_PAYWALL=
