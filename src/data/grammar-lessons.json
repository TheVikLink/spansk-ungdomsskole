    {
      "id": "a0.articles.indefinite",
      "level": "A0",
      "category": "Artikler og substantiv",
      "title": "Velg un, una, unos eller unas",
      "status": "published",
      "reviewedBy": null,
      "reviewedAt": null,
      "learningGoal": "Jeg kan velge un, una, unos eller unas når jeg snakker om én eller flere ting på en ubestemt måte.",
      "explanation": "Ubestemte artikler betyr omtrent en, ei, et eller noen. Velg formen etter substantivets kjønn og tall.",
      "theorySections": [
        {
          "title": "Entall",
          "text": "Bruk un foran hankjønn og una foran hunkjønn når du snakker om én ting.",
          "examples": [
            "un libro → en bok",
            "una mochila → en sekk"
          ]
        },
        {
          "title": "Flertall",
          "text": "Bruk unos foran hankjønn og unas foran hunkjønn når du mener noen eller flere.",
          "examples": [
            "unos libros → noen bøker",
            "unas mochilas → noen sekker"
          ]
        },
        {
          "title": "Artikkelen følger substantivet",
          "text": "Endelsen på substantivet kan gi et hint, men lær gjerne ordet sammen med artikkelen. Unntakene fra hovedregelen gjelder også her.",
          "examples": [
            "un problema → et problem",
            "una mano → en hånd"
          ]
        }
      ],
      "forms": [
        {
          "article": "un",
          "gender": "hankjønn",
          "number": "entall"
        },
        {
          "article": "una",
          "gender": "hunkjønn",
          "number": "entall"
        },
        {
          "article": "unos",
          "gender": "hankjønn",
          "number": "flertall"
        },
        {
          "article": "unas",
          "gender": "hunkjønn",
          "number": "flertall"
        }
      ],
      "examples": [
        {
          "es": "Tengo un libro.",
          "no": "Jeg har en bok."
        },
        {
          "es": "Tengo una mochila.",
          "no": "Jeg har en sekk."
        },
        {
          "es": "Veo unos perros.",
          "no": "Jeg ser noen hunder."
        },
        {
          "es": "Veo unas casas.",
          "no": "Jeg ser noen hus."
        }
      ],
      "tip": "Husk forskjellen: un/una er entall, mens unos/unas er flertall. Lær substantivet sammen med artikkelen når du kan.",
      "shortHint": "Velg ubestemt artikkel etter substantivets kjønn og tall.",
