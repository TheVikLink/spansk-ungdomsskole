    {
      "id": "a1.patterns.productive",
      "level": "A1",
      "category": "Setninger og uttrykk",
      "title": "Produktive mønstre: bygg setninger",
      "status": "published",
      "reviewedBy": null,
      "reviewedAt": null,
      "learningGoal": "Jeg kan hente fram en fast verbfrase og sette den sammen med naturlige avslutninger.",
      "explanation": "I stedet for å pugge hele setninger utenat, kan du lære noen faste verbfraser som du kan kombinere med mange ulike ord. Fire av de viktigste er tengo, quiero, me gusta og voy a.",
      "theorySections": [
        {
          "title": "Tengo: tilstand, alder og eie",
          "text": "Bruk tengo når du forteller om alder (tengo quince años), tilstander (tengo hambre, tengo frío) eller ting du har (tengo un perro). Husk at hvis du må gjøre noe, sier du tengo que + infinitiv.",
          "examples": [
            "Tengo hambre. → Jeg er sulten.",
            "Tengo quince años. → Jeg er femten år.",
            "Tengo que estudiar. → Jeg må øve."
          ]
        },
        {
          "title": "Quiero: ønsker og vilje",
          "text": "Quiero betyr «jeg vil ha» foran et substantiv (quiero agua), og «jeg vil» foran et verb i infinitiv (quiero comer, quiero descansar).",
          "examples": [
            "Quiero agua. → Jeg vil ha vann.",
            "Quiero comer. → Jeg vil spise.",
            "Quiero hablar español. → Jeg vil snakke spansk."
          ]
        },
        {
          "title": "Me gusta: ting og aktiviteter du liker",
          "text": "Me gusta betyr «jeg liker». Foran et verb i infinitiv betyr det at du liker å gjøre noe (me gusta bailar). Foran et substantiv i entall bruker du bestemt artikkel (me gusta la música).",
          "examples": [
            "Me gusta bailar. → Jeg liker å danse.",
            "Me gusta la música. → Jeg liker musikk.",
            "Me gusta leer. → Jeg liker å lese."
          ]
        },
        {
          "title": "Voy a: nær framtid",
          "text": "Når du skal fortelle hva du skal gjøre snart, bruker du voy a + infinitiv. Det tilsvarer «jeg skal» på norsk.",
          "examples": [
            "Voy a dormir. → Jeg skal sove.",
            "Voy a estudiar. → Jeg skal studere.",
            "Voy a ver una película. → Jeg skal se en film."
          ]
        }
      ],
      "forms": [
        {
          "article": "tengo",
          "gender": "tilstand / alder / eie",
          "number": "hambre, 15 años, un perro"
        },
        {
          "article": "quiero",
          "gender": "ønsker (+ inf / subst)",
          "number": "comer, descansar, agua"
        },
        {
          "article": "me gusta",
          "gender": "liker (+ inf / entall)",
          "number": "bailar, leer, la música"
        },
        {
          "article": "voy a",
          "gender": "framtid (+ inf)",
          "number": "dormir, estudiar, jugar"
        }
      ],
      "examples": [
        {
          "es": "Tengo hambre.",
          "no": "Jeg er sulten."
        },
        {
          "es": "Quiero descansar.",
          "no": "Jeg vil hvile."
        },
        {
          "es": "Me gusta la música.",
          "no": "Jeg liker musikk."
        },
        {
          "es": "Voy a dormir.",
          "no": "Jeg skal sove."
        }
      ],
      "tip": "Tenk på hva du vil uttrykke: tilstand/alder (tengo), ønske (quiero), preferanse (me gusta) eller planer (voy a).",
      "shortHint": "tengo = tilstand/alder; quiero = ønske; me gusta = like; voy a = skal.",
      "skillIds": [
        "a0.patterns.tengo",
        "a1.patterns.quiero",
        "a1.patterns.me_gusta",
        "a1.patterns.voy_a"
      ],
      "practice": {
