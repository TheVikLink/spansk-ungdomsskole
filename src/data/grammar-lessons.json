    {
      "id": "a1.adjectives.regular_o",
      "level": "A1",
      "category": "Adjektiv og adverb",
      "title": "La adjektivet følge substantivet",
      "status": "published",
      "reviewedBy": null,
      "reviewedAt": null,
      "learningGoal": "Jeg kan velge riktig form av et adjektiv på -o etter substantivets kjønn og tall.",
      "explanation": "Spanske adjektiver som beskriver et substantiv, må passe med substantivet. Når grunnformen slutter på -o, endrer adjektivet slutten etter kjønn og tall.",
      "theorySections": [
        {
          "title": "Fire former",
          "text": "Hankjønn entall får -o, hunkjønn entall får -a, hankjønn flertall får -os og hunkjønn flertall får -as.",
          "examples": [
            "un chico alto → en høy gutt",
            "una chica alta → en høy jente",
            "unos chicos altos → noen høye gutter",
            "unas chicas altas → noen høye jenter"
          ]
        },
        {
          "title": "Finn substantivet først",
          "text": "Se på ordet adjektivet beskriver. Finn kjønn og tall der først, og velg så riktig adjektivform.",
          "examples": [
            "La casa es bonita.",
            "Los perros son pequeños."
          ]
        },
        {
          "title": "Ikke bland kjønn og tall",
          "text": "Endelsen viser to ting samtidig: -a betyr hunkjønn entall, mens -as betyr hunkjønn flertall. På samme måte betyr -o hankjønn entall, og -os hankjønn flertall.",
          "examples": [
            "una mochila negra → en svart sekk",
            "unas mochilas negras → noen svarte sekker"
          ]
        }
      ],
      "forms": [
        {
          "article": "alto",
          "gender": "hankjønn",
          "number": "entall"
        },
        {
          "article": "alta",
          "gender": "hunkjønn",
          "number": "entall"
        },
        {
          "article": "altos",
          "gender": "hankjønn",
          "number": "flertall"
        },
        {
          "article": "altas",
          "gender": "hunkjønn",
          "number": "flertall"
        }
      ],
      "examples": [
        {
          "es": "El chico es alto.",
          "no": "Gutten er høy."
        },
        {
          "es": "La chica es alta.",
          "no": "Jenta er høy."
        },
        {
          "es": "Los chicos son altos.",
          "no": "Guttene er høye."
        },
        {
          "es": "Las chicas son altas.",
          "no": "Jentene er høye."
        }
      ],
      "tip": "Finn substantivet først. Adjektivet følger substantivets kjønn og tall, også når substantivet står etter verbet.",
      "shortHint": "Se på substantivet og velg -o, -a, -os eller -as.",
