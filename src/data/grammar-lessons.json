    {
      "id": "a1.adjectives.common_gender",
      "level": "A1",
      "category": "Adjektiv og adverb",
      "title": "Adjektiv på -e: samme form for kjønn",
      "status": "published",
      "reviewedBy": null,
      "reviewedAt": null,
      "learningGoal": "Jeg kan bruke adjektiv på -e i entall og flertall.",
      "explanation": "Mange adjektiver som slutter på -e, har samme form for hankjønn og hunkjønn. I flertall får de vanligvis -s.",
      "theorySections": [
        {
          "title": "Kjønn endrer ikke formen",
          "text": "Et adjektiv på -e ser likt ut etter et hankjønnsord og et hunkjønnsord. Det er tallet som endrer formen.",
          "examples": [
            "un chico inteligente → en intelligent gutt",
            "una chica inteligente → en intelligent jente"
          ]
        },
        {
          "title": "Flertall får -s",
          "text": "Når substantivet er i flertall, legger du vanligvis til -s på et adjektiv som allerede slutter på -e.",
          "examples": [
            "chicos inteligentes → intelligente gutter",
            "casas grandes → store hus"
          ]
        },
        {
          "title": "Finn substantivet først",
          "text": "Se først om substantivet er entall eller flertall. Ikke lag en egen hunkjønnsform som inteligenta eller granda.",
          "examples": [
            "El profesor es inteligente.",
            "Las casas son grandes."
          ]
        }
      ],
      "forms": [
        {
          "article": "inteligente",
          "gender": "hankjønn eller hunkjønn",
          "number": "entall"
        },
        {
          "article": "inteligentes",
          "gender": "hankjønn eller hunkjønn",
          "number": "flertall"
        }
      ],
      "examples": [
        {
