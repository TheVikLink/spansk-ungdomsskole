    {
      "id": "a1.ser.identity",
      "level": "A1",
      "category": "Setninger og uttrykk",
      "title": "Ser: hvem du er og hvor du kommer fra",
      "status": "published",
      "reviewedBy": null,
      "reviewedAt": null,
      "learningGoal": "Jeg kan bruke riktig form av ser når jeg forteller hvem noen er, hva de jobber med eller hvor de kommer fra.",
      "explanation": "Ser bruker vi når vi identifiserer personer, forteller om yrke eller sier hvor noen kommer fra.",
      "theorySections": [
        {
          "title": "Formene i presens",
          "text": "Med yo bruker du soy, med tú eres, med él, ella og usted es, med nosotros somos og med ellos, ellas og ustedes son.",
          "examples": [
            "Yo soy de Noruega.",
            "Mi padre es profesor.",
            "Nosotros somos estudiantes."
          ]
        },
        {
          "title": "Identitet og yrke",
          "text": "Bruk ser når du sier hvem noen er eller hvilket yrke de har. I en enkel yrkesbeskrivelse står yrket vanligvis uten un eller una.",
          "examples": [
            "Ella es Ana.",
            "Mi madre es profesora."
          ]
        },
        {
          "title": "Opprinnelse",
          "text": "Bruk ser de for å si hvor noen kommer fra.",
          "examples": [
            "Soy de Oslo.",
            "Mis amigos son de México."
          ]
        }
      ],
      "forms": [
        {
          "article": "soy",
          "gender": "yo",
          "number": "entall"
        },
        {
          "article": "eres",
          "gender": "tú",
          "number": "entall"
        },
        {
          "article": "es",
          "gender": "él/ella/usted",
          "number": "entall"
        },
        {
          "article": "somos",
          "gender": "nosotros",
          "number": "flertall"
        },
        {
          "article": "son",
          "gender": "ellos/ellas/ustedes",
          "number": "flertall"
        }
      ],
      "examples": [
        {
          "es": "Yo soy de Noruega.",
          "no": "Jeg er fra Norge."
        },
        {
          "es": "Mi padre es profesor.",
          "no": "Faren min er lærer."
        },
        {
          "es": "Nosotros somos estudiantes.",
          "no": "Vi er elever."
        },
